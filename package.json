{
  "name": "kirana-shop-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db.ts migrate",
    "db:reset": "node --env-file-if-exists=.env.local --import tsx scripts/db.ts reset",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres:///kirana_test} vitest run tests/db --no-file-parallelism"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "paytmchecksum": "^1.5.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "5.0.3"
  }
}
