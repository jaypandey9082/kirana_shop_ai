# Copy to .env.local when connecting services. Never commit real credentials.
# Section 1 runs without an env file. These are reserved for later sections.
APP_URL=http://localhost:3000

# Database (server-only). Local Postgres for development, Supabase connection string later.
DATABASE_URL=postgres:///kirana_dev

# Supabase: only NEXT_PUBLIC values can be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: reads parchi photos and spoken orders (Responses API, strict JSON schema).
# Needs a vision-capable model your key can use, e.g. one listed in OpenAI's vision guide. Both must be set.
OPENAI_API_KEY=
OPENAI_MODEL=

# Sarvam: verify available model and speaker names before connecting.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_LANGUAGE=hi-IN
# Optional, only if your model supports it (e.g. codemix):
SARVAM_STT_MODE=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# Payments: mock (default) or paytm. paytm without MID + key turns online payment off; it never falls back to mock silently.
# Paytm webhook URL to set in the dashboard: {APP_URL}/api/payments/paytm/webhook (HTTPS, port 443).
PAYMENT_PROVIDER=mock
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
# Staging hosts from Paytm docs (Sep 2026). Initiate and status use different hosts; confirm with real credentials.
PAYTM_HOST=https://securestage.paytmpayments.com
PAYTM_STATUS_HOST=https://securegw-stage.paytmpayments.in
# Optional override; default is {PAYTM_HOST}/merchantpgpui/checkoutjs/merchants/{MID}.js
PAYTM_CHECKOUT_JS_URL=

# Approved-action automation. Keep both webhook secrets server-side.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=

# Demo reset must remain disabled until implemented and protected.
DEMO_RESET_ENABLED=false
DEMO_RESET_SECRET=
